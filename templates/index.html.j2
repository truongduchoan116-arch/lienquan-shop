<!doctype html>
<html lang="{{ lang }}" data-theme="{{ theme }}" data-theme-default="{{ theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} | {{ shop.tagline }}</title>
  <meta name="description" content="{{ shop.description }}">
  <meta name="theme-color" content="{{ shop.colors.primary }}">
  <meta name="color-scheme" content="dark light">
  <meta name="robots" content="index, follow">
  {% if canonical %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:url" content="{{ canonical }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ shop.name }} | {{ shop.tagline }}">
  <meta property="og:description" content="{{ shop.description }}">
  <meta property="og:locale" content="vi_VN">
  {% if og_image %}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ og_image }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ shop.name }} | {{ shop.tagline }}">
  <meta name="twitter:description" content="{{ shop.description }}">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="manifest.webmanifest">
  <style>:root{--c-primary:{{ shop.colors.primary }};--c-secondary:{{ shop.colors.secondary }};--c-electric:{{ shop.colors.electric }};--c-gold:{{ shop.colors.gold }};}</style>
  <link rel="stylesheet" href="css/style.css">
  <script>
    (function () {
      var d = document.documentElement, t = d.getAttribute("data-theme-default") || "dark";
      try { var s = localStorage.getItem("theme"); if (s === "light" || s === "dark") t = s; } catch (e) {}
      d.setAttribute("data-theme", t);
      if (/FBAN|FBAV|FB_IAB|Instagram|TikTok|musical_ly|BytedanceWebview|Zalo|Line\//i.test(navigator.userAgent)) { d.className += " inapp"; }
    })();
  </script>
</head>
<body{% if shop.bg %} style="--bg-image:url('{{ shop.bg }}')" class="has-bg"{% endif %}>
  <a class="skip-link" href="#main">Bỏ qua đến nội dung chính</a>

  <p class="inapp-tip" id="inapp-tip" hidden>Nếu có nút không mở được, hãy bấm dấu ⋯ rồi chọn “Mở bằng trình duyệt”.</p>

  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="{{ shop.name }}">
        {% if shop.logo %}<img class="brand-logo" src="{{ shop.logo }}" alt="" width="36" height="36">
        {% else %}<span class="brand-mark" aria-hidden="true">{{ shop.initials }}</span>{% endif %}
        <span class="brand-name">{{ shop.name }}</span>
      </a>
      <nav class="nav" aria-label="Menu chính">
        <a href="#services">Dịch vụ</a>
        {% if featured %}<a href="#links">Liên kết</a>{% endif %}
        <a href="#faq">FAQ</a>
        <a href="#contact">Liên hệ</a>
      </nav>
      <div class="header-actions">
        <button type="button" class="icon-btn" id="share-btn" data-title="{{ shop.name }}" data-copied="Đã sao chép link website" data-fail="Không sao chép được, hãy sao chép thủ công." aria-label="Chia sẻ website" hidden>{{ icon('share') }}</button>
        <button type="button" class="icon-btn" id="theme-toggle" aria-label="Đổi giao diện sáng/tối" hidden>
          <span class="t-dark">{{ icon('sun') }}</span><span class="t-light">{{ icon('moon') }}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        {% if shop.logo %}<img class="hero-avatar" src="{{ shop.logo }}" alt="Logo {{ shop.name }}" width="132" height="132" fetchpriority="high">
        {% else %}<div class="hero-avatar placeholder" role="img" aria-label="Logo {{ shop.name }}">{{ shop.initials }}</div>{% endif %}
        <p class="eyebrow">{{ shop.tagline }}</p>
        <h1 id="hero-title">{{ shop.name }}{% if shop.example %} <span class="badge" title="Nội dung mẫu, hãy thay bằng thông tin thật trong config.py">Ví dụ</span>{% endif %}</h1>
        {% if shop.owner %}<p class="owner">Người bán: {{ shop.owner }}</p>{% endif %}
        <p class="lead">{{ shop.description }}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact">Liên hệ shop</a>
          <a class="btn btn-secondary" href="#services">Khám phá dịch vụ</a>
        </div>
      </div>
    </section>

    <!-- SOCIAL -->
    {% if socials %}
    <section class="section tight" aria-labelledby="social-title">
      <div class="container">
        <h2 id="social-title" class="sr-only">Kết nối với shop</h2>
        <ul class="social-list">
          {% for c in socials %}
          <li>
            <a class="social-link{% if loop.first and c.key in ['messenger_url','facebook_url'] %} is-main{% endif %}" href="{{ c.href }}"
               {% if c.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
              <span class="social-icon">{{ icon(c.icon) }}</span>
              <span class="social-text"><strong>{{ c.platform }}</strong><span>{{ c.description }}</span></span>
              {% if c.external %}<span class="sr-only">(mở trong tab mới)</span>{% endif %}
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}

    <!-- SERVICES -->
    <section id="services" class="section" aria-labelledby="services-title">
      <div class="container">
        <h2 id="services-title">Dịch vụ của shop</h2>
        <ul class="grid">
          {% for sv in services %}
          <li class="card service">
            <span class="card-icon">{{ icon(sv.icon) }}</span>
            <h3>{{ sv.name }}</h3>
            <p>{{ sv.description }}</p>
            {% if sv.action_info %}
            <a class="btn btn-ghost btn-sm" href="{{ sv.action_info.href }}" {% if sv.action_info.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
              {{ sv.action }}<span class="sr-only"> – {{ sv.name }}</span>{% if sv.action_info.external %}{{ icon('external') }}{% endif %}
            </a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <!-- FEATURED LINKS -->
    {% if featured %}
    <section id="links" class="section" aria-labelledby="links-title">
      <div class="container">
        <h2 id="links-title">Liên kết nổi bật</h2>
        <ul class="featured">
          {% for f in featured %}
          <li><a class="feature-link" href="{{ f.url }}" target="_blank" rel="noopener noreferrer">
            <span class="card-icon">{{ icon(f.icon) }}</span>
            <span class="social-text"><strong>{{ f.label }}</strong><span>{{ f.description }}</span></span>
            <span class="sr-only">(mở trong tab mới)</span>
          </a></li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}

    <!-- FAQ -->
    <section id="faq" class="section" aria-labelledby="faq-title">
      <div class="container narrow">
        <h2 id="faq-title">Câu hỏi thường gặp</h2>
        <div class="faq">
          {% for item in faq %}
          <details>
            <summary><span>{{ item.q }}</span>{{ icon('chevron', 'icon chev') }}</summary>
            <p>{{ item.a }}</p>
          </details>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="container">
        <h2 id="contact-title">Liên hệ shop</h2>
        <div class="contact-grid">
          <div class="card">
            {% set mains = socials|selectattr('key', 'in', ['messenger_url', 'facebook_url', 'email'])|list %}
            {% if mains %}
            <div class="cta-row stack">
              {% for c in mains %}
              <a class="btn {{ 'btn-primary' if loop.first else 'btn-secondary' }}" href="{{ c.href }}" {% if c.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ icon(c.icon) }}{{ c.platform }}{% if c.external %}<span class="sr-only"> (mở trong tab mới)</span>{% endif %}
              </a>
              {% endfor %}
            </div>
            {% else %}
            <p class="muted">Shop chưa cấu hình kênh liên hệ. Chủ shop vui lòng điền Messenger, Facebook hoặc Email trong <code>config.py</code>.</p>
            {% endif %}
            <p class="note">Không gửi mật khẩu game hoặc mã OTP cho bất kỳ ai, kể cả khi họ nhân danh shop.</p>
          </div>

          <div class="card share-card">
            <h3>Chia sẻ website</h3>
            <div class="cta-row stack">
              <button type="button" class="btn btn-secondary" id="share-btn-2" data-title="{{ shop.name }}" data-copied="Đã sao chép link website" data-fail="Không sao chép được, hãy sao chép thủ công." hidden>{{ icon('share') }}<span>Chia sẻ</span></button>
              <button type="button" class="btn btn-ghost" id="copy-url" data-ok="Đã sao chép link website" data-fail="Không sao chép được, hãy sao chép thủ công." hidden>{{ icon('copy') }}<span>Sao chép link</span></button>
            </div>
            <p class="status-msg" id="action-status" role="status" aria-live="polite"></p>
            {% if qr_svg %}
            <figure class="qr">
              <div class="qr-box">{{ qr_svg }}</div>
              <figcaption>Quét mã QR để mở website</figcaption>
            </figure>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <p class="footer-name"><strong>{{ shop.name }}</strong></p>
        {% if socials %}
        <ul class="social-mini" aria-label="Mạng xã hội">
          {% for c in socials %}
          <li><a class="icon-btn" href="{{ c.href }}" aria-label="{{ c.platform }}" title="{{ c.platform }}" {% if c.external %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ icon(c.icon) }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
        <a class="btn btn-ghost btn-sm" href="#top">{{ icon('arrow-up') }}Về đầu trang</a>
      </div>
      {% if footer.policy_url %}<p class="footer-line"><a href="{{ footer.policy_url }}" target="_blank" rel="noopener noreferrer">Chính sách</a></p>{% endif %}
      {% if footer.text %}<p class="footer-line">{{ footer.text }}</p>{% endif %}
      <p class="footer-line muted">{{ footer.disclaimer }}</p>
      <p class="footer-line muted">© {{ year }} {{ shop.name }} · Cập nhật <time datetime="{{ updated }}">{{ updated }}</time></p>
    </div>
  </footer>

  {% if primary_contact %}
  <a class="float-contact" href="{{ primary_contact.href }}" {% if primary_contact.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
    {{ icon(primary_contact.icon) }}Liên hệ nhanh{% if primary_contact.external %}<span class="sr-only"> (mở trong tab mới)</span>{% endif %}
  </a>
  {% endif %}

  <script src="js/main.js" defer></script>
</body>
</html>
